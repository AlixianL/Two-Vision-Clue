    - target: {fileID: 7291796475107693938, guid: 21f1b7083c8689943861f98736defc98, type: 3}
      propertyPath: m_text
      value: "La Vall\xE9e des Rois, n\xE9cropole des grands pharaons comme Tout\xE2nkhamon
        et Rams\xE8s II. Construit en -1550, elle abrite des tombes orn\xE9es pour
        assurer la renaissance dans l\u2019au-del\xE0. En lien avec Karnak, centre
        du culte d\u2019Amon, elle illustre l\u2019unit\xE9 entre pouvoir terrestre
        et vie \xE9ternelle, compl\xE9tant ainsi la dimension spirituelle de Th\xE8bes."
      objectReference: {fileID: 0}
