    - target: {fileID: 7291796475107693938, guid: 21f1b7083c8689943861f98736defc98, type: 3}
      propertyPath: m_text
      value: "Command\xE9 par la reine Hatchepsout, ce sanctuaire en granit abritait
        la barque d\u2019Amon lors des processions. Orn\xE9 de sc\xE8nes rituelles,
        il c\xE9l\xE9brait le pouvoir divin de la souveraine. D\xE9mont\xE9 apr\xE8s
        sa mort puis reconstitu\xE9 au XXe si\xE8cle, il incarne l\u2019art raffin\xE9
        et l\u2019autorit\xE9 religieuse du Nouvel Empire."
      objectReference: {fileID: 0}
