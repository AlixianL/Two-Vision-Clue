    - target: {fileID: 7291796475107693938, guid: 21f1b7083c8689943861f98736defc98, type: 3}
      propertyPath: m_text
      value: "\nLes pyramides de Gizeh, construites pour Kh\xE9ops en -2250, Kh\xE9phren
        et Myk\xE9rinos, symbolisent l\u2019apog\xE9e de l\u2019architecture fun\xE9raire
        \xE9gyptienne et la croyance en la r\xE9surrection royale. Bien qu\u2019\xE9loign\xE9es
        de Karnak, elles illustrent la continuit\xE9 du pouvoir pharaonique, reliant
        la m\xE9moire des rois anciens au culte divin d\xE9velopp\xE9 \xE0 Karnak
        durant le Nouvel Empire."
      objectReference: {fileID: 0}
