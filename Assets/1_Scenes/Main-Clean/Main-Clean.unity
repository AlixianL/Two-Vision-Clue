    - target: {fileID: 7291796475107693938, guid: 21f1b7083c8689943861f98736defc98, type: 3}
      propertyPath: m_text
      value: "\nLe Sphinx de Gizeh, symbole de force et de protection royale, veille
        depuis des mill\xE9naires sur les pyramides. Pr\xE9sent\xE9 \xE0 Karnak en
        -2500, il \xE9voque son r\xF4le de gardien dans l\u2019iconographie \xE9gyptienne,
        notamment dans les temples d\u2019Amon. Cette vitrine souligne la continuit\xE9
        entre la majest\xE9 fun\xE9raire de Gizeh et le pouvoir religieux de Karnak."
      objectReference: {fileID: 0}
