    - target: {fileID: 7291796475107693938, guid: 21f1b7083c8689943861f98736defc98, type: 3}
      propertyPath: m_text
      value: "Ces bijoux de Karnak, r\xE9alis\xE9s en mat\xE9riaux pr\xE9cieux, m\xEAlent
        raffinement artistique et symbolisme sacr\xE9. Port\xE9s ou offerts en offrandes,
        ils exprimaient le statut et invoquaient la protection divine. Leurs motifs,
        comme le scarab\xE9e ou l\u2019\u0153il oudjat, incarnaient vie, renaissance
        et harmonie cosmique."
      objectReference: {fileID: 0}
